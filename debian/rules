#!/usr/bin/make -f

export CARGO_HOME = $(CURDIR)/debian/cargo-home

# Build for musl, so the packaged binary is statically linked and the package
# carries no libc floor.
#
# Until this, the .deb was the one Linux artifact built against glibc: the
# release binaries have always been musl, while dpkg-buildpackage rebuilt from
# source with whatever glibc the build container happened to carry. That put
# `Depends: libc6 (>= 2.39)` on every published package, which Debian 12 (2.36)
# and Ubuntu 22.04 (2.35) do not satisfy - so `apt install` failed on an
# oldstable supported into 2028 and an LTS into 2027.
#
# `Depends` is generated from `${shlibs:Depends}`, so nothing in debian/control
# needs to change: dpkg-shlibdeps finds no shared libraries in a static binary
# and the substitution comes out empty.
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
RUST_TARGET_amd64 = x86_64-unknown-linux-musl
RUST_TARGET_arm64 = aarch64-unknown-linux-musl
RUST_TARGET = $(RUST_TARGET_$(DEB_HOST_ARCH))

# Fail here rather than silently building for the host. A package that quietly
# went back to glibc would reintroduce the floor with nothing to notice it, and
# the release that shipped it is immutable.
ifeq ($(RUST_TARGET),)
$(error no musl Rust target is mapped for DEB_HOST_ARCH=$(DEB_HOST_ARCH); add one above)
endif

# Where cargo puts a cross-target build. Every path below reads this rather
# than target/release, which is the host build that no longer happens.
BUILT = target/$(RUST_TARGET)/release/podup
# Pin the target dir so a CARGO_TARGET_DIR from the environment cannot move
# the binary away from the path the install step expects.
export CARGO_TARGET_DIR = $(CURDIR)/target

# When a vendor/ directory is present (offline/air-gapped builds), configure
# Cargo to use it exclusively.  The vendor/ tree is generated by running
# `cargo vendor vendor` at the repository root and including the output in
# the source tarball.
ifneq ($(wildcard vendor/),)
export CARGO_NET_OFFLINE = true
CARGO_FLAGS = --frozen --offline
endif

# Drop the self-update stack (ureq + TLS + Ed25519) from the packaged binary:
# apt owns upgrades on Debian, so `podup update` is disabled here. `completions`
# stays on — the install step below generates the shell scripts from the binary.
CARGO_FEATURES = --no-default-features --features watch,completions

%:
	dh $@

override_dh_auto_build:
ifneq ($(wildcard vendor/),)
	$(if $(wildcard $(CARGO_HOME)/config.toml),,$(MAKE) -f debian/rules debian/cargo-config)
endif
	cargo build --release --locked --target $(RUST_TARGET) $(CARGO_FLAGS) $(CARGO_FEATURES)

override_dh_auto_test:
	cargo test --release --locked --target $(RUST_TARGET) $(CARGO_FLAGS) $(CARGO_FEATURES)

override_dh_auto_install:
	install -D -m 0755 $(BUILT) debian/podup/usr/bin/podup
	# Shell completions, generated from the freshly built binary so they can
	# never drift from the CLI definition.
	install -d debian/podup/usr/share/bash-completion/completions
	install -d debian/podup/usr/share/zsh/vendor-completions
	install -d debian/podup/usr/share/fish/vendor_completions.d
	$(BUILT) completions bash > debian/podup/usr/share/bash-completion/completions/podup
	$(BUILT) completions zsh  > debian/podup/usr/share/zsh/vendor-completions/_podup
	$(BUILT) completions fish > debian/podup/usr/share/fish/vendor_completions.d/podup.fish

# Stamp the man page's .TH version and date from debian/changelog so they never
# drift from the release. The date comes from the changelog entry, not the build
# clock, to keep the build reproducible.
override_dh_installman:
	set -e; \
	ver=$$(dpkg-parsechangelog --show-field Version | sed 's/-[^-]*$$//'); \
	dat=$$(LC_ALL=C date -u -d "$$(dpkg-parsechangelog --show-field Date)" +'%B %Y'); \
	cp -p debian/podup.1 debian/podup.1.bak; \
	sed -i -E "s/\"podup [0-9]+\.[0-9]+\.[0-9]+\"/\"podup $$ver\"/; s/^\.TH PODUP 1 \"[^\"]*\"/.TH PODUP 1 \"$$dat\"/" debian/podup.1; \
	dh_installman; \
	mv debian/podup.1.bak debian/podup.1

override_dh_auto_clean:
	cargo clean
	rm -rf debian/cargo-home
	# The vendor mapping a vendored build writes lives under CARGO_HOME, removed
	# just above, so a later non-vendored build cannot inherit it. The tracked
	# .cargo/config.toml holds only per-target link flags and stays.
	# Restore the man page if an installman run was interrupted before it could
	# revert its in-place version stamp.
	test ! -f debian/podup.1.bak || mv debian/podup.1.bak debian/podup.1

# Point cargo at the vendor tree (only when vendored). Written under
# CARGO_HOME, which cargo reads alongside the tracked .cargo/config.toml, so
# the per-target link flags there apply to the vendored build too and a
# source package never has to overwrite a tracked file.
debian/cargo-config:
ifneq ($(wildcard vendor/),)
	mkdir -p $(CARGO_HOME)
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "vendor"\n' > $(CARGO_HOME)/config.toml
endif
